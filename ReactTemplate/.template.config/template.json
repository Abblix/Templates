{
    "$schema": "http://json.schemastore.org/template",
    "author": "abblix.com",
    "classifications": [
        "Web",
        "MVC",
        "SPA",
        "React",
        "TypeScript",
        "Vite"
    ],
    "name": "ASP.NET Core MVC with React and Vite",
    "description": "An ASP.NET Core MVC project template featuring a SPA built with React, TypeScript, and Vite",
    "precedence": "0",
    "identity": "Abblix.ReactTemplate",
    "sourceName": "ReactTemplate",
    "defaultName": "ReactApp",
    "shortName": "abblix-react",
    "aliases": [
        "react-net10",
        "react-typescript",
        "react-vite"
    ],
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "HttpsPort": {
            "type": "parameter",
            "datatype": "integer",
            "defaultValue": "5000",
            "replaces": "5000",
            "description": "Port for the ASP.NET Core host HTTPS endpoint in launchSettings.json."
        },
        "SpaProxyPort": {
            "type": "parameter",
            "datatype": "integer",
            "defaultValue": "3000",
            "replaces": "3000",
            "description": "Port for the Vite dev server that SpaProxy connects to (SpaProxyServerUrl and vite.config.ts)."
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                ".template.config/**/*",
                "**/*.filelist",
                "**/*.user",
                "**/*.lock.json",
                "**/node_modules/**",
                "ClientApp/dist/**"
            ]
        }
    ]
}