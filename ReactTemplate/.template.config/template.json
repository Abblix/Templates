{
    "$schema": "http://json.schemastore.org/template",
    "author": "abblix.com",
    "classifications": [
        "Web",
        "MVC",
        "SPA",
        "React",
        "TypeScript",
        "Vite"
    ],
    "name": "ASP.NET Core MVC with React and Vite",
    "description": "An ASP.NET Core MVC project template featuring a SPA built with React, TypeScript, and Vite",
    "precedence": "0",
    "identity": "Abblix.ReactTemplate",
    "sourceName": "ReactTemplate",
    "defaultName": "ReactApp",
    "shortName": [
        "abblix-react",
        "react-net",
        "react-typescript",
        "react-vite"
    ],
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "HttpsPort": {
            "type": "parameter",
            "datatype": "integer",
            "description": "HTTPS port the ASP.NET Core host is served on. When omitted or 0, a port free on this machine is picked at random between 7000 and 7300 as the project is created."
        },
        "HttpsPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 7000,
                "high": 7300
            }
        },
        "HttpsPortReplacer": {
            "type": "generated",
            "generator": "coalesce",
            "parameters": {
                "sourceVariableName": "HttpsPort",
                "fallbackVariableName": "HttpsPortGenerated",
                "defaultValue": "0"
            },
            "replaces": "5000"
        },
        "SpaProxyPort": {
            "type": "parameter",
            "datatype": "integer",
            "description": "Port of the Vite dev server the host starts during development. When omitted or 0, a port free on this machine is picked at random between 5173 and 5273 as the project is created."
        },
        "SpaProxyPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 5173,
                "high": 5273
            }
        },
        "SpaProxyPortReplacer": {
            "type": "generated",
            "generator": "coalesce",
            "parameters": {
                "sourceVariableName": "SpaProxyPort",
                "fallbackVariableName": "SpaProxyPortGenerated",
                "defaultValue": "0"
            },
            "replaces": "3000"
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                ".template.config/**/*",
                "**/*.filelist",
                "**/*.user",
                "**/*.lock.json",
                "**/node_modules/**",
                "ClientApp/dist/**"
            ]
        }
    ]
}