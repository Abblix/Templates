{
    "$schema": "http://json.schemastore.org/template",
    "author": "abblix.com",
    "classifications": [
        "Web",
		"MVC",
		"OpenID",
		"OIDC",
		"OAuth2.0"
    ],
    "name": "Abblix OpenID Provider - Getting Started (in-memory)",
    "description": "A minimal OpenID Provider on Abblix OIDC Server for learning: in-memory user and client stores and an ephemeral signing key, with talking comments and warnings that point at the production choices. For a production-shaped starter, use the abblix-oidc-server template instead.",
    "precedence": "0",
    "identity": "Abblix.OpenIDProviderTemplate",
    "sourceName": "OpenIDProviderApp",
    "defaultName": "OpenIDProvider",
    "shortName": "abblix-oidc-server-gettingstarted",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "HttpsPort": {
            "type": "parameter",
            "datatype": "integer",
            "description": "HTTPS port the provider is served on and names in its issuer. When omitted or 0, a port free on this machine is picked at random between 7000 and 7300 as the project is created."
        },
        "HttpsPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 7000,
                "high": 7300
            }
        },
        "HttpsPortReplacer": {
            "type": "generated",
            "generator": "coalesce",
            "parameters": {
                "sourceVariableName": "HttpsPort",
                "fallbackVariableName": "HttpsPortGenerated",
                "defaultValue": "0"
            },
            "replaces": "5001"
        },
        "user": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "",
            "description": "Email/login of a dev sample user to pre-seed. If omitted, no sample user is created."
        },
        "password": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "Passw0rd!",
            "description": "Password for the --user sample account. Dev-only: stored and compared in plaintext. Ignored when --user is omitted."
        },
        "userInCSharp": {
            "type": "derived",
            "valueSource": "user",
            "valueTransform": "cSharpString",
            "replaces": "SAMPLE_USER_EMAIL"
        },
        "passwordInCSharp": {
            "type": "derived",
            "valueSource": "password",
            "valueTransform": "cSharpString",
            "replaces": "SAMPLE_USER_PASSWORD"
        },
        "HasSampleUser": {
            "type": "computed",
            "value": "(user != \"\")"
        },
        "SampleUserSubject": {
            "type": "generated",
            "generator": "guid",
            "replaces": "SAMPLE_USER_SUBJECT",
            "parameters": {
                "defaultFormat": "D"
            }
        }
    },
    "forms": {
        "cSharpString": {
            "identifier": "chain",
            "steps": [ "escapeBackslash", "escapeQuote", "escapeCarriageReturn", "escapeLineFeed", "escapeNextLine", "escapeLineSeparator", "escapeParagraphSeparator" ]
        },
        "escapeBackslash": {
            "identifier": "replace",
            "pattern": "\\\\",
            "replacement": "\\\\"
        },
        "escapeQuote": {
            "identifier": "replace",
            "pattern": "\"",
            "replacement": "\\\""
        },
        "escapeCarriageReturn": {
            "identifier": "replace",
            "pattern": "\\r",
            "replacement": "\\r"
        },
        "escapeLineFeed": {
            "identifier": "replace",
            "pattern": "\\n",
            "replacement": "\\n"
        },
        "escapeNextLine": {
            "identifier": "replace",
            "pattern": "\\u0085",
            "replacement": "\\u0085"
        },
        "escapeLineSeparator": {
            "identifier": "replace",
            "pattern": "\\u2028",
            "replacement": "\\u2028"
        },
        "escapeParagraphSeparator": {
            "identifier": "replace",
            "pattern": "\\u2029",
            "replacement": "\\u2029"
        }
    }
}