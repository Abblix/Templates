<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
<!--#if (UseMvc) -->
    <PackageReference Include="Abblix.Oidc.Server.Mvc" Version="3.1.0" />
<!--#else -->
    <PackageReference Include="Abblix.Oidc.Server.MinimalApi" Version="3.1.0" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!-- It declares the demo clients and their published secret: keep it out of the published app. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
