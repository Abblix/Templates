{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Development only: appsettings.json declares no client, so a host started in any other environment has none.
  "Oidc": {
    "Clients": [
      {
        // An interactive client: a user signs in on the login page and the client exchanges the code for tokens,
        // as requests.http walks through in a browser.
        "ClientId": "test_client",
        // SHA-512 hash of the demo secret "secret", published with this template - the provider stores hashes, never plain secrets
        "ClientSecrets": [ { "Sha512Hash": "vSsar3708Jvp9Szi2NWZZ02Bqp1qRCFpbcTZPdBhnWgs5WtNZKnvCXdhztmeD2cmW192CF5bDufKRpayrW/isg==" } ],
        "TokenEndpointAuthMethod": "client_secret_post",
        "AllowedGrantTypes": [ "authorization_code" ],
        "PkceRequired": true,
        // A loopback IP address over http with no port: an authorization request may name any port on it
        // (RFC 8252, section 7.3), so a client of your own can listen on any free port. Nothing in this project
        // serves the address, so in the requests.http walkthrough the code is read from the browser's address bar.
        "RedirectUris": [ "http://127.0.0.1/callback" ],
        // Matched exactly, port included: a client of your own on another port adds its own address here.
        "PostLogoutRedirectUris": [ "http://127.0.0.1/signed-out" ]
      },
      {
        // A headless client that obtains a token through client_credentials and introspects it, with no user
        // and no browser involved.
        "ClientId": "console_client",
        // SHA-512 hash of the demo secret "secret", published with this template - the provider stores hashes, never plain secrets
        "ClientSecrets": [ { "Sha512Hash": "vSsar3708Jvp9Szi2NWZZ02Bqp1qRCFpbcTZPdBhnWgs5WtNZKnvCXdhztmeD2cmW192CF5bDufKRpayrW/isg==" } ],
        "TokenEndpointAuthMethod": "client_secret_post",
        "AllowedGrantTypes": [ "client_credentials" ],
        // No resource: its secret is published with this template, so its token is addressed only to this
        // provider (the issuer), and no API registered in Resources accepts it.
        "AllowedResources": []
      }
    ]
  }
}
