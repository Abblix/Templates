{
    "$schema": "http://json.schemastore.org/template",
    "author": "abblix.com",
    "classifications": [
        "Web",
        "MVC",
        "OpenID",
        "OIDC",
        "OAuth2.0",
        "Identity"
    ],
    "name": "Abblix OpenID Provider (ASP.NET Identity + EF Core)",
    "description": "A production-shaped OpenID Provider built on Abblix OIDC Server: ASP.NET Core Identity users on EF Core (SQLite), durable client and signing-key stores, and password hashing. Start a real project from here.",
    "precedence": "0",
    "identity": "Abblix.OpenIDProviderIdentityTemplate",
    "sourceName": "AspNetIdentitySample",
    "defaultName": "OpenIDProvider",
    "shortName": "abblix-oidc-server",
    "aliases": [
        "oidc-server",
        "oauth2-server",
        "openidconnect"
    ],
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "HttpsPort": {
            "type": "parameter",
            "datatype": "integer",
            "defaultValue": "5001",
            "replaces": "5001",
            "description": "Port for the HTTPS endpoint in launchSettings.json."
        },
        "user": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "",
            "replaces": "SAMPLE_USER_EMAIL",
            "description": "Email/login of a dev sample user to pre-seed into the Identity store. If omitted, no sample user is created."
        },
        "password": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "",
            "replaces": "SAMPLE_USER_PASSWORD",
            "description": "Password for the --user sample account. If omitted, a random one is generated and printed once on first run. Ignored when --user is omitted."
        },
        "HasSampleUser": {
            "type": "computed",
            "value": "(user != \"\")"
        },
        "HasSamplePassword": {
            "type": "computed",
            "value": "(password != \"\")"
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                ".template.config/**/*",
                "**/*.filelist",
                "**/*.user",
                "**/*.lock.json",
                "ClientAssets/node_modules/**",
                "wwwroot/lib/**",
                "**/*.db",
                "dataprotection-keys/**"
            ]
        }
    ]
}
