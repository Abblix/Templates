{
    "$schema": "http://json.schemastore.org/template",
    "author": "abblix.com",
    "classifications": [
        "Web",
        "MVC",
        "OpenID",
        "OIDC",
        "OAuth2.0",
        "Identity"
    ],
    "name": "Abblix OpenID Provider (ASP.NET Identity + EF Core)",
    "description": "A production-shaped OpenID Provider built on Abblix OIDC Server: ASP.NET Core Identity users on EF Core (SQLite), durable client and signing-key stores, and password hashing. Start a real project from here.",
    "precedence": "0",
    "identity": "Abblix.OpenIDProviderIdentityTemplate",
    "sourceName": "AspNetIdentitySample",
    "defaultName": "OpenIDProvider",
    "shortName": [
        "abblix-oidc-server",
        "oidc-server",
        "oauth2-server",
        "openidconnect"
    ],
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "preferNameDirectory": true,
    "symbols": {
        "HttpsPort": {
            "type": "parameter",
            "datatype": "integer",
            "description": "HTTPS port the provider is served on and names in its issuer. When omitted or 0, a port free on this machine is picked at random between 7000 and 7300 as the project is created."
        },
        "HttpsPortGenerated": {
            "type": "generated",
            "generator": "port",
            "parameters": {
                "low": 7000,
                "high": 7300
            }
        },
        "HttpsPortReplacer": {
            "type": "generated",
            "generator": "coalesce",
            "parameters": {
                "sourceVariableName": "HttpsPort",
                "fallbackVariableName": "HttpsPortGenerated",
                "defaultValue": "0"
            },
            "replaces": "5001"
        },
        "user": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "",
            "description": "Email address of a dev sample user to pre-seed into the Identity store; it is also the login, so it takes the characters Identity accepts in a user name: Latin letters, digits and -._@+. Any other value stops the first run with Identity's error. If omitted, no sample user is created."
        },
        "password": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "",
            "description": "Password for the --user sample account. If omitted, a random one is generated and printed once on first run. Ignored when --user is omitted."
        },
        "userInCSharp": {
            "type": "derived",
            "valueSource": "user",
            "valueTransform": "cSharpString",
            "replaces": "SAMPLE_USER_EMAIL"
        },
        "passwordInCSharp": {
            "type": "derived",
            "valueSource": "password",
            "valueTransform": "cSharpString",
            "replaces": "SAMPLE_USER_PASSWORD"
        },
        "HasSampleUser": {
            "type": "computed",
            "value": "(user != \"\")"
        },
        "HasSamplePassword": {
            "type": "computed",
            "value": "(password != \"\")"
        }
    },
    "forms": {
        "cSharpString": {
            "identifier": "chain",
            "steps": [ "escapeBackslash", "escapeQuote", "escapeCarriageReturn", "escapeLineFeed", "escapeNextLine", "escapeLineSeparator", "escapeParagraphSeparator" ]
        },
        "escapeBackslash": {
            "identifier": "replace",
            "pattern": "\\\\",
            "replacement": "\\\\"
        },
        "escapeQuote": {
            "identifier": "replace",
            "pattern": "\"",
            "replacement": "\\\""
        },
        "escapeCarriageReturn": {
            "identifier": "replace",
            "pattern": "\\r",
            "replacement": "\\r"
        },
        "escapeLineFeed": {
            "identifier": "replace",
            "pattern": "\\n",
            "replacement": "\\n"
        },
        "escapeNextLine": {
            "identifier": "replace",
            "pattern": "\\u0085",
            "replacement": "\\u0085"
        },
        "escapeLineSeparator": {
            "identifier": "replace",
            "pattern": "\\u2028",
            "replacement": "\\u2028"
        },
        "escapeParagraphSeparator": {
            "identifier": "replace",
            "pattern": "\\u2029",
            "replacement": "\\u2029"
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                ".template.config/**/*",
                "**/*.filelist",
                "**/*.user",
                "**/*.lock.json",
                "ClientAssets/node_modules/**",
                "wwwroot/lib/**",
                "**/*.db",
                "dataprotection-keys/**"
            ]
        }
    ]
}
