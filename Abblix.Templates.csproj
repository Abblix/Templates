<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Package metadata follows https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
    <PackageId>Abblix.Templates</PackageId>
    <PackageVersion>3.0.0</PackageVersion>
    <Title>Abblix .NET Project Templates</Title>
    <Authors>Abblix LLP</Authors>
    <Description>Project templates for dotnet new: two OpenID Provider templates built on Abblix OIDC Server 3.0, and an ASP.NET Core MVC host with a React and Vite frontend.</Description>
    <PackageTags>aspnetcore mvc react typescript vite frontend openidconnect oauth2 authentication security identityserver abblix</PackageTags>
    <PackageProjectUrl>https://github.com/Abblix/Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Abblix/Templates</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageIcon>Abblix.png</PackageIcon>

    <!-- Keep package type as 'Template' to show the package as a template package on nuget.org and make your template available in dotnet new search.-->
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <LocalizeTemplates>false</LocalizeTemplates>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="7.0.120" PrivateAssets="all" IsImplicitlyDefined="true"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Abblix.png" Link="Abblix.png" Pack="true" PackagePath="" />
    <Content Include=".\Nuget\README.md" Link="README.md" Pack="true" PackagePath="" />
    <Content Include="**\*" Exclude=".*\**;*;**\bin\**;**\obj\**;**\node_modules\**;**\dist\**;**\wwwroot\lib\**;**\*.db;**\dataprotection-keys\**;**\.idea\**;Nuget\**;skills\**;docs\**;Vsix\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
